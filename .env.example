# Local backend port and Vite proxy target.
PORT=3001

# Leave DATABASE_URL unset for local SQLite, or set it to a PostgreSQL connection
# string to use Neon locally. Never commit a real connection string.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Local SQLite file. Docker Compose overrides this to /data/bail-reckoner.sqlite.
BAIL_RECKONER_DB=./database/bail-reckoner.sqlite

# Cloudflare Pages origin for API CORS. Use the exact deployed frontend origin.
CORS_ORIGIN=http://localhost:5173

# Set to the Render API URL when running the frontend build/development server
# against a separately hosted API. Leave blank to use Vite's local /api proxy.
VITE_API_BASE_URL=

# Render hosts only the API; the Cloudflare Pages deployment serves the frontend.
SERVE_FRONTEND=false

# Optional override if the backend is not available at localhost:$PORT.
# API_PROXY_TARGET=http://localhost:3001
